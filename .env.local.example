# Copiar pra .env.local e preencher com as credenciais do projeto Supabase
# (Supabase Dashboard → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role) -- só pra código de servidor (API routes),
# nunca prefixar com NEXT_PUBLIC_. Necessária pra criar login de equipe.
SUPABASE_SERVICE_ROLE_KEY=
